//bufferi za levu ruku: (aka moze 4 tona odjednom)
SndBuf buf1 => ADSR env1 => dac;
SndBuf buf2 => ADSR env2 => dac;
SndBuf buf3 => ADSR env3 => dac;
SndBuf buf4 => ADSR env4 => dac;

//bufferi za desnu ruku:
SndBuf buf5 => ADSR env5 => dac;
SndBuf buf6 => ADSR env6 => dac;
SndBuf buf7 => ADSR env7 => dac;

SndBuf pauza => dac;

SndBuf snareb => dac;


BlowBotl noise => dac;

//odredjivanje random tempa

SndBuf lofiBuf => dac;


//definisanje duzina notnih vrednosti na osnovu random tempa
//tj odredjivanje trajanja cele note, polovine etc.
Math.random2f(2500,4000) => float rythm;
// 1500 => rythm;

//<<<rythm>>>;
rythm::ms => dur beat;

beat * 3 / 4 => dur polovina_tacka;
beat / 2 => dur polovina;
beat * 3 / 8 => dur cetvrtina_tacka;
beat / 4 => dur cetvrtina;
beat / 8 => dur osmina;

[beat, polovina_tacka, polovina, cetvrtina_tacka, cetvrtina, osmina] @=> dur duzine[];

6::second => dur whole;               //duzina cele note ako zatreba


//leva ruka envelopes
(50::ms, 70::ms, 0.8, 30::ms) => env1.set;
(50::ms, 70::ms, 0.8, 30::ms) => env2.set;
(50::ms, 70::ms, 0.8, 30::ms) => env3.set;
(50::ms, 70::ms, 0.8, 30::ms) => env4.set;

//desna ruka envelopes
(10::ms, 30::ms, 0.3, 70::ms) => env5.set;
(10::ms, 30::ms, 0.3, 70::ms) => env6.set;
(10::ms, 30::ms, 0.3, 70::ms) => env7.set;
//attack, delay, sustain, release

//jacina leve ruke
6 => int leva_ruka_jacina;
leva_ruka_jacina => buf1.gain;
leva_ruka_jacina => buf2.gain;     
leva_ruka_jacina => buf3.gain;
leva_ruka_jacina => buf4.gain;

//jacina desne ruke
14 => int desna_ruka_jacina;
desna_ruka_jacina => buf5.gain;
desna_ruka_jacina => buf6.gain;
desna_ruka_jacina => buf7.gain;

0 => pauza.gain;

// 0.1 => snareb.gain;

// svi brojevi izmedju -6 i 6 radi normalne visine
[
[-5, -1, 2, 5, 0, 4, 7, 0, -5, -1, 2, 5, 0, 4, 7,0],    //V-I, tj G7-C                     0
[2,5,-3,2, -5,-1,2,5, 0,4,7,0,  0,4,7,0],   //ii-V-I, tj Dm-G7-C                           1
[2,6,-3,0,  -5,-1,2,5,   0,4,7,0, 0,4,7,0],   //II7-V-I, tj D7-G7-C                        2
[2,5,-4,4,  -5,-1,2,5, -3,0,4,-5, 0, 4, 7,0],  //ii-V-VI-I, tj Dm-G7-Am7-C                 3
[0,4,-5,0, 5,-3,0,-5, 0,4,7,12, 5,-3,0,5], //I-IV, tj C-F                                  4
[0,4,7,0,  -3,1,4,-3,  2,5,9,0,  -5,-1,2,-7], // 1-VI7-ii7-V7   , tj C - A7 - Dm7 - G7     5
] @=> int jazz_progressions[][];

int koja_progresija;
Math.random2(0, jazz_progressions.cap()-1) => koja_progresija;

jazz_progressions[koja_progresija] @=> int glavni_tonovi[];
<<<"progresija: ",koja_progresija>>>;

[0, 4, 7, 11] @=> int glavni_d7[];
[0, 3, 7, 11] @=> int glavni_m7[];

[0, 2, 4, 7, 9, 11] @=> int dozvoljeni[];





[[0, 1, 2, 0], [0, 2, 1, 0], [0, 1, 0, 2], [1, 0, 2, 0]] @=> int kratki_leva[][];

kratki_leva[Math.random2(0, kratki_leva.cap()-1)] @=> int leva[];

Math.random2(22,33) => int offset;
<<<"offset: ", offset>>>;

int ukupan_broj_akorda[4];

int left_hand[glavni_tonovi.cap()];


for (0 => int i; i<ukupan_broj_akorda.cap(); i++)
{
    for(0 => int j; j<leva.cap(); j++)
    {
        glavni_tonovi[i*4 + leva[j]] => left_hand[i*4 + j];
    }
}


fun void noiseFun()
{
    Math.random2f(0, 0.08) => noise.noiseGain;
    while(true)
    {
        1 => noise.startBlowing;
        beat => now;
    }
}

fun void lofiBeats()
{
    Math.random2(1,3) => int koji_lofi;
    //<<<"lofi:", koji_lofi>>>;
    lofi_beats[koji_lofi] => lofiBuf.read;

    while(true)
    {

        if(koji_lofi == 1)
        {        
            3020/rythm  => lofiBuf.rate;
            0.6 => lofiBuf.gain;
        }

        if(koji_lofi == 2)
        {
            2900/rythm => lofiBuf.rate;
            0.8 => lofiBuf.gain;
        }

        if(koji_lofi == 3)
        {
            3300/rythm => lofiBuf.rate;
            0.9 => lofiBuf.gain;
        }
        
        0 => lofiBuf.pos;
        beat => now;
    }
    
}


//templates - sabloni za 'levu ruku'


fun void levaRuka1()                //funkcija za reprodukovanje jednog od ,,šablona" za pozadinsku melodiju
{
    while(true)
    {
        for(0 => int m; m<ukupan_broj_akorda.cap(); m++)      //ponavlja se toliko puta koliko ima akorda
        {
        
            note[ukupan_broj_akorda[m] + offset] => buf1.read;        //učitavanje note u bafer
            93000 => buf1.pos;              //krece od 1. sekunde zbog pauze na početku audio fajla
            1 => env1.keyOn;                //primenjivanje ranije definisanih ADSR parametara

            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+1]] => buf2.read;
            1 => env2.keyOn;
            93000 => buf2.pos;
        
            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+2]] => buf3.read;     
            1 => env3.keyOn;
            93000 => buf3.pos;

            beat/2 => now;      //vreme ,,napreduje", tj. reprodukuju se fajlovi koji stoje u baferu

            93000 => buf1.pos;      //vraćanje audio fajla na početnu poziciju
            93000 => buf2.pos;
            93000 => buf3.pos;

            beat/4 => now;
                    
            //snare => snareb.read;   //zvuk bubnja

            beat/4 => now;
        }   
    }
}


fun void levaRuka2()
{
    while(true)
    {
        for(0 => int m; m<ukupan_broj_akorda.cap(); m++)
        {
            for (0 => int i; i<1; i++)
            {
                note[offset +12] => buf1.read;
                93000 => buf1.pos;
                1 => env1.keyOn;

                note[ukupan_broj_akorda[m] + offset + left_hand[m*4+1]+12] => buf2.read;
                1 => env2.keyOn;
                93000 => buf2.pos;
            
                note[ukupan_broj_akorda[m] + offset + left_hand[m*4+2]] => buf3.read;
                1 => env3.keyOn;
                93000 => buf3.pos;
            
                note[left_hand[4*m] + offset + ukupan_broj_akorda[m]] => buf4.read;
                93000 => buf4.pos;
                1 => env4.keyOn;
                beat/2=> now;

                note[left_hand[4*m +2] + offset + ukupan_broj_akorda[m]] => buf4.read;
                93000 => buf4.pos;
                beat*3/8 => now;

                note[left_hand[4*m +1] + offset + ukupan_broj_akorda[m]] => buf4.read;
                93000 => buf4.pos;
                beat/8 => now;
                
            }
        }   
    }
}




fun void levaRuka3()
{
    while(true)
    {
        for(0 => int m; m<ukupan_broj_akorda.cap(); m++)
        {
            note[ukupan_broj_akorda[m] + offset + left_hand[m*4]] => buf1.read;
            93000 => buf1.pos;              //krece od 2.6 sekunde zbog pauze
            1 => env1.keyOn;

            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+1]] => buf2.read;
            1 => env2.keyOn;
            93000 => buf2.pos;
        
            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+2] ] => buf3.read;
            1 => env3.keyOn;
            93000 => buf3.pos;

            beat/2 => now;


            93000 => buf1.pos;
            93000 => buf2.pos;
            93000 => buf3.pos;

            beat/4 => now;


            note[ukupan_broj_akorda[m]+offset + left_hand[m*4] ] => buf4.read;
            1 => env4.keyOn;
            93000 => buf4.pos;

            note[ukupan_broj_akorda[m] + offset + left_hand[m*4 + 1]] => buf3.read;
            1 => env3.keyOn;
            93000 => buf3.pos;
            //snare => snareb.read;

            beat/4 => now;

        } 
    }
}



//nije dobra bukv je za 2 akorda
fun void levaRuka5()                //funkcija za reprodukovanje jednog od ,,šablona" za pozadinsku melodiju
{
    while(true)
    {
        for(0 => int m; m<2; m++)      //ponavlja se 2 puta
        {
        
            note[ukupan_broj_akorda[m] + offset] => buf1.read;        //učitavanje note u bafer
            93000 => buf1.pos;              //krece od 3.8 sekunde zbog pauze na početku audio fajla
            1 => env1.keyOn;                //primenjivanje ranije definisanih ADSR parametara

            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+1]] => buf2.read;
            1 => env2.keyOn;
            93000 => buf2.pos;
        
            note[ukupan_broj_akorda[m] + offset + left_hand[m*4+2]] => buf3.read;     
            1 => env3.keyOn;
            93000 => buf3.pos;

            beat => now;      //vreme ,,napreduje", tj. reprodukuju se fajlovi koji stoje u baferu

            93000 => buf1.pos;      //vraćanje audio fajla na početnu poziciju
            93000 => buf2.pos;
            93000 => buf3.pos;

        }   
    }
}

fun void prva_nota_u_taktu(int nota_trenutno, int broj_note_u_taktu, int brojac1, dur trajanje_nota_u_taktu[])
{
    if((nota_trenutno >= 0)&&(nota_trenutno<dozvoljeni.cap()))
    {
        prva_nota_u_taktu_norm_oktava(nota_trenutno, offset);
    }

    else if(nota_trenutno >= dozvoljeni.cap())
    {
        prva_nota_u_taktu_oktava_vise(nota_trenutno, offset, brojac1);
    }
    else if(nota_trenutno < 0)
    {
        prva_nota_u_taktu_oktava_nize(nota_trenutno, offset, brojac1);
    }
    
    35000 => buf7.pos;
    (trajanje_nota_u_taktu[broj_note_u_taktu]/4, trajanje_nota_u_taktu[broj_note_u_taktu]*3/2-5::ms, 0, 5::ms) => env7.set;
    1 => env7.keyOn;
        
    trajanje_nota_u_taktu[broj_note_u_taktu] => now; 
}

fun void prva_nota_u_taktu_norm_oktava(int nota_trenutno, int offset)
{
    
    for (0 => int f; f<dozvoljeni.cap(); f++)
    {
        for (0 => int g; g<dozvoljeni.cap(); g++)
        {
            if (dozvoljeni[nota_trenutno]==dozvoljeni[f])
            {
                f => nota_trenutno;
                note[dozvoljeni[nota_trenutno] + offset + 12] => buf7.read;
                dozvoljeni.cap() => g;
                dozvoljeni.cap() => f;
            }
        }
    }

}

fun void prva_nota_u_taktu_oktava_vise(int nota_trenutno, int offset, int brojac1)
{
    until(nota_trenutno < dozvoljeni.cap())
    {
        1 +=> brojac1;
        dozvoljeni.cap() -=> nota_trenutno;
    }
        
    for (0 => int f; f<dozvoljeni.cap(); f++)
    {
        for (0 => int g; g<dozvoljeni.cap(); g++)
        {
            if (dozvoljeni[nota_trenutno] == dozvoljeni[f])
            {
                note[dozvoljeni[f] + 12*brojac1 + offset + 12] => buf7.read;
                f + dozvoljeni.cap()*brojac1 => nota_trenutno;
                dozvoljeni.cap() => g;
                dozvoljeni.cap() => f;
            }
        }
    }
    0 => brojac1;
}

fun void prva_nota_u_taktu_oktava_nize(int nota_trenutno, int offset, int brojac1)
{
    until(nota_trenutno >= 0)
    {
        1 +=> brojac1;
        dozvoljeni.cap() +=> nota_trenutno;
    }
        
    for (0 => int f; f<dozvoljeni.cap(); f++)
    {
        for (0 => int g; g<dozvoljeni.cap(); g++)
        {
            if (dozvoljeni[nota_trenutno] == dozvoljeni[f])
            {
                note[dozvoljeni[f] - 12*brojac1 + offset + 12] => buf7.read;
                f - dozvoljeni.cap()*brojac1 => nota_trenutno;
                dozvoljeni.cap() => g;
                dozvoljeni.cap() => f;
            }
        }
    }
    0 => brojac1;  
}


fun void oscMenjaj(int env_brojac, int x, dur trajanje[], int broj)
{
    if (env_brojac%3 == 0)
    {
        note[x] => buf6.read;
        35000 => buf6.pos;
        env6.keyOn();
        trajanje[broj] => now;
        env6.keyOff();
    }
    else if (env_brojac%3 == 1)
    {
        note[x] => buf7.read;
        35000 => buf7.pos;
        env7.keyOn();
        trajanje[broj] => now;
        env7.keyOff();
    }
    else
    {
        note[x] => buf5.read;
        35000 => buf5.pos;
        env5.keyOn();
        trajanje[broj] => now;
        env5.keyOff();
    }
}

0 => int nota_za_sviranje;

fun void ostale_note_u_taktu(int nota_trenutno, int g, int brojac1, dur trajanje_nota_u_taktu[], int env_brojac)
{
    Math.random2(-2, 2) => int skok;

    if (nota_trenutno + skok >= dozvoljeni.cap())
    {
        while(nota_trenutno + skok >= dozvoljeni.cap())
        {
            1 +=> brojac1;
            dozvoljeni.cap() -=> nota_trenutno;
        }

        dozvoljeni[nota_trenutno + skok] + 12*brojac1 + offset + 12 => int nota_za_sviranje;

        if ((dozvoljeni[nota_trenutno + skok] + 12*brojac1 + offset + 12) > 55)
        {
            dozvoljeni.cap() -=> nota_trenutno;
        }

        brojac1 * dozvoljeni.cap() +=> nota_trenutno;                            
        0 => brojac1;
    }

    else if ((nota_trenutno + skok >= 0)&&(nota_trenutno + skok < dozvoljeni.cap()))
    {
        dozvoljeni[nota_trenutno + skok] + offset + 12 => nota_za_sviranje;
    }

    else if (nota_trenutno + skok < 0)
    {
        while(nota_trenutno + skok < 0)
        {
            1 +=> brojac1;
            dozvoljeni.cap() +=> nota_trenutno;
        }
        dozvoljeni[skok + nota_trenutno] - 12*brojac1 + offset + 12 => nota_za_sviranje;
        
        if ((dozvoljeni[nota_trenutno + skok] + 12*brojac1 + offset + 12) < 30)
        {
            dozvoljeni.cap() +=> nota_trenutno;
        }

        brojac1 * dozvoljeni.cap() -=> nota_trenutno;
        0 => brojac1;
    }

    oscMenjaj(env_brojac, nota_za_sviranje, trajanje_nota_u_taktu, g);

    skok +=> nota_trenutno;

}


dur trajanje_nota_u_taktu[8];
0 => int brojac1;
0 => int env_brojac;

fun void desnaRuka()
{
    // beat*4 => now;
    Math.random2(0, 3) => int nota_trenutno;

    while(true)
    {   
        for (0 => int broj_akorda; broj_akorda<ukupan_broj_akorda.cap(); broj_akorda++)          //broj akorda
        {
            0::ms => dur ukupno_takt;
            
            for (0 => int broj_note_u_taktu; broj_note_u_taktu < trajanje_nota_u_taktu.cap(); broj_note_u_taktu++)      //16 puta basically
            {
                Math.random2(0,5) => int random_duzina_note;

                if (ukupno_takt + duzine[random_duzina_note] <= beat)
                {
                    duzine[random_duzina_note] => trajanje_nota_u_taktu[broj_note_u_taktu];
                    duzine[random_duzina_note] +=> ukupno_takt;                
                    
                    if(broj_note_u_taktu==0)
                    {
                        prva_nota_u_taktu(nota_trenutno, broj_note_u_taktu, brojac1, trajanje_nota_u_taktu);
                    }

                    else
                    {
                        ostale_note_u_taktu(nota_trenutno, broj_note_u_taktu, brojac1, trajanje_nota_u_taktu, env_brojac);
                    }

                    1 +=> env_brojac;

                    //generise se sekvenca od odredjenog broja duzine notnih vrednosti, tako da ukupna duzina odgovara
                    //duzini reprodukcije jednog takta
                }
            }
        }
    }
}

Math.random2(1,4) => int koja_leva_ruka;
3 => koja_leva_ruka;
<<<koja_leva_ruka>>>;
if (koja_leva_ruka==1)
{
    spork ~ levaRuka1();
}
else if (koja_leva_ruka==2)
{
    spork ~ levaRuka2();
}
else if (koja_leva_ruka==3)
{
    spork ~ levaRuka3();
}
else if (koja_leva_ruka == 5)
{
    spork ~ levaRuka5();
}

Math.random2(1,2) => int rain_dice;
// 2 => rain_dice;
if(rain_dice == 1){
    spork ~ rainsound();
}
spork ~ desnaRuka();
// spork ~ noiseFun();
spork ~ lofiBeats();
